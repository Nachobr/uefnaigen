{
  "name": "uefn-ai",
  "version": "0.2.0-beta",
  "description": "ForgeAI — AI-powered UEFN world generator. Turn natural language into UEFN project scaffolds.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "uefn-ai": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "uefn",
    "fortnite",
    "verse",
    "ai",
    "game-development",
    "code-generator"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('node:fs'); fs.cpSync('../../vendor/uefn-mcp','dist/vendor/uefn-mcp',{recursive:true});\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@forgeai/ai": "workspace:*",
    "@forgeai/core": "workspace:*",
    "@forgeai/packager": "workspace:*",
    "@forgeai/prefabs": "workspace:*",
    "@forgeai/schemas": "workspace:*",
    "@forgeai/templates": "workspace:*",
    "@forgeai/uefn-bridge": "workspace:*",
    "@forgeai/validators": "workspace:*",
    "commander": "^14.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
